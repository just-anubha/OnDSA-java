import java.util.Scanner;
public class second_largestoptimal{       //this is the best optimal soln of second largest with time complexity O[n]
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the size of an array: ");
        int n=sc.nextInt();
        int[]arr=new int[n];
        System.out.println("Enter number of elements in array: ");
        for(int i=0;i<arr.length;i++){
            arr[i]=sc.nextInt();
        }
        
        int largest=arr[0];
        int s_largest = Integer.MIN_VALUE;
         for(int i=0;i<n;i++){
            if(arr[i]>largest){
                s_largest=largest;
                largest=arr[i];

            }
            else if((arr[i]<largest) &&(arr[i]>s_largest)){
                s_largest=arr[i];
            }
         }
         System.out.println("Largest element is : "+largest);
         if(s_largest == Integer.MIN_VALUE){
             System.out.println("No second largest element exists");
         }
         else{
             System.out.println("Second Largest element is : "+s_largest);
         }
    }
}